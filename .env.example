# Copy this file to .env and fill in the appropriate values for your environment.
# All variables marked as [REQUIRED] must be set for the application to work.

# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================

# Environment name (e.g., development, staging, production)
# [REQUIRED] Used for logging and configuration context
ENVIRONMENT=development

# =============================================================================
# GOOGLE CLOUD PLATFORM CONFIGURATION
# =============================================================================

# Google Cloud Project ID where your resources are located
# [REQUIRED] Example: my-gcp-project-12345
GCP_PROJECT_ID=

# Path to Google Cloud service account credentials JSON file
# [REQUIRED FOR DEVELOPMENT] Only needed for local development environment
# In cloud environments, this should be omitted as authentication is handled automatically
# Example: /path/to/service-account-key.json
GOOGLE_APPLICATION_CREDENTIALS=

# BigQuery table for storing ETL results
# [REQUIRED] Format: dataset.table_name
# Example: etl_data.well_level_mantoverde
GCP_BIGQUERY_TABLE=

# =============================================================================
# DATA INPUT CONFIGURATION
# =============================================================================

# Time series service API endpoint
# [REQUIRED] Example: https://timeseries-api.example.com
TIMESERIES_SERVICE_URL=

# =============================================================================
# DATA OUTPUT CONFIGURATION (INFLUXDB)
# =============================================================================

# InfluxDB server URL
# [REQUIRED] Example: https://influx.example.com:8086
INFLUXDB_URL=

# InfluxDB bucket name for storing time series data
# [REQUIRED] Example: well-level-data
INFLUXDB_BUCKET=

# Secret Manager key name for InfluxDB authentication token
# [REQUIRED] Example: influxdb-token
INFLUXDB_TOKEN_KEY=

# InfluxDB organization name
# [REQUIRED] Example: mantoverde-org
INFLUXDB_ORG=

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# Auth0 domain for API authentication
# [REQUIRED] Example: your-tenant.auth0.com
AUTH0_DOMAIN=

# Auth0 API audience identifier
# [REQUIRED] Example: https://api.example.com
AUTH0_AUDIENCE=

# Auth0 client ID for machine-to-machine authentication
# [REQUIRED] Example: abcd1234efgh5678ijkl
AUTH0_CLIENT_ID=

# Secret Manager key name for Auth0 client secret
# [REQUIRED] Example: auth0-client-secret
AUTH0_CLIENT_SECRET_KEY=

# =============================================================================
# REDIS CACHE CONFIGURATION
# =============================================================================

# Redis server hostname for token caching
# [REQUIRED] Example: redis.example.com
REDIS_HOST_TOKEN_CACHE=

# Redis server port for token caching
# [REQUIRED] Example: 6379
REDIS_PORT_TOKEN_CACHE=

# Secret Manager key name for Redis password
# [REQUIRED] Example: redis-password
REDIS_PASS_TOKEN_CACHE_KEY=

# =============================================================================
# LOGGING CONFIGURATION (OPTIONAL)
# =============================================================================

# Enable Google Cloud Logging (set to "true" to enable)
# [OPTIONAL] Default: false
# When enabled, logs will be sent to Google Cloud Logging
# When disabled, logs will use Rich formatting for local development
USE_CLOUD_LOGGING=false
